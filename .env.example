# Example environment file for llm-eval-lab.
#
# Copy this file to `.env` and fill in real values:
#
#   cp .env.example .env
#
# `.env` is gitignored and is never committed. No agent working this
# repository reads a real `.env`.
#
# `src/llm_eval_lab/settings.py` is the ONLY module that reads process
# environment variables, via pydantic-settings with `env_prefix="LLM_EVAL_"`.
# Every `LLM_EVAL_*` variable below maps to one `Settings` field (the field
# name, upper-cased, prefixed with `LLM_EVAL_`). A value that is not a simple
# scalar (a list or a set) is parsed as JSON, e.g.
# `LLM_EVAL_PLUGINS_ALLOWED='["acme_evals"]'`.
#
# Provider credentials are a separate story: they are looked up by NAME on
# demand, through `read_credential()`, and are never `Settings` fields. A
# `ProviderConfig` records which environment variable holds a key (e.g.
# `OPENAI_API_KEY`), never the key value itself, so a saved run configuration
# is safe to persist, log and return over the API verbatim. Only set the
# credential variables for the providers you actually use.

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------

# Root directory for generated state. Only the SQLite database lives here in
# v1. Defaults to ~/.local/share/llm-eval-lab.
# LLM_EVAL_DATA_DIR=/path/to/state/dir

# SQLAlchemy async database URL. When unset, resolves to a SQLite file under
# LLM_EVAL_DATA_DIR (sqlite+aiosqlite:///<data_dir>/llm-eval-lab.db).
# Architecture is PostgreSQL-compatible by design (see docs/architecture.md);
# PostgreSQL is not shipped or tested by this project.
# LLM_EVAL_DATABASE_URL=sqlite+aiosqlite:///./llm-eval-lab.db

# ---------------------------------------------------------------------------
# Benchmark loading
# ---------------------------------------------------------------------------

# Directory a suite name is resolved under; paths escaping it are refused.
# Unset means no root confinement beyond the current working directory.
# LLM_EVAL_SUITES_ROOT=/path/to/benchmarks

# Hard cap on a suite file's size, applied before parsing. Default 8388608 (8 MiB).
# LLM_EVAL_MAX_SUITE_BYTES=8388608

# ---------------------------------------------------------------------------
# Run defaults
# ---------------------------------------------------------------------------

# Default in-flight cases per run when `llm-eval run` does not override it.
# Default 8.
# LLM_EVAL_CONCURRENCY=8

# Default in-flight judge calls, held below LLM_EVAL_CONCURRENCY on purpose.
# Default 4.
# LLM_EVAL_JUDGE_CONCURRENCY=4

# Default wall-clock budget for one case, retries included, in seconds.
# Default 120.0.
# LLM_EVAL_CASE_TIMEOUT_S=120.0

# Cap on a stored vendor payload; an oversized payload is replaced by a
# marker rather than stored in full. Default 65536 bytes.
# LLM_EVAL_MAX_RAW_BYTES=65536

# Bound on one regex-evaluator match, so a pathological pattern cannot hang a
# run. Default 2.0 seconds.
# LLM_EVAL_MAX_REGEX_MATCH_S=2.0

# Candidate output is truncated to this many characters before being shown to
# an LLM-as-judge evaluator. Default 8000.
# LLM_EVAL_MAX_OUTPUT_CHARS=8000

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------

# DEBUG, INFO, WARNING, ERROR or CRITICAL. Default INFO.
LLM_EVAL_LOG_LEVEL=INFO

# console (human-readable) or json (one object per line, for machines).
# Default console.
# LLM_EVAL_LOG_FORMAT=console

# Log prompt and output text at DEBUG level. Off by default because prompts
# and model output are user data.
LLM_EVAL_LOG_PROMPTS=false

# ---------------------------------------------------------------------------
# API server (see `llm-eval serve`)
# ---------------------------------------------------------------------------

# Bind address. A non-loopback bind is refused unless LLM_EVAL_API_TOKEN is
# set. Default 127.0.0.1.
LLM_EVAL_API_HOST=127.0.0.1

# Bind port. Default 8000.
LLM_EVAL_API_PORT=8000

# Bearer token required to expose the API off loopback; also checked as a
# bearer credential on every request when set. Never logged. Leave unset (or
# empty) to run loopback-only with no auth, which is the default and is safe
# for local use.
LLM_EVAL_API_TOKEN=

# Allowed browser origins for the dashboard, as a JSON array. Never "*": this
# API can start runs that spend money. Default
# '["http://localhost:5173"]' (the Vite dev server).
# LLM_EVAL_CORS_ORIGINS=["http://localhost:5173"]

# Cap on a request body, applied before parsing. Default 4194304 bytes (4 MiB).
# LLM_EVAL_MAX_REQUEST_BYTES=4194304

# ---------------------------------------------------------------------------
# Plugins
# ---------------------------------------------------------------------------

# Load third-party evaluator entry points. Off by default: they execute
# arbitrary code, and a benchmark file can never enable this itself.
LLM_EVAL_PLUGINS_ENABLED=false

# Entry-point names permitted when LLM_EVAL_PLUGINS_ENABLED is true, as a
# JSON array. Empty (the default) means none are allowed even when enabled.
# LLM_EVAL_PLUGINS_ALLOWED=["acme_evals"]

# ---------------------------------------------------------------------------
# Provider credentials
#
# Only the variable NAME is ever stored in a ProviderConfig (as
# `api_key_env`), never the value. Set the ones for the providers you
# actually use; every provider integration is optional and lazily imported,
# so an unset key only matters if you try to use that provider. See
# docs/providers.md for the full list, each provider's install extra, and
# known normalization gaps.
# ---------------------------------------------------------------------------

# OpenAI (`llm-eval-lab[openai]`)
OPENAI_API_KEY=your-openai-api-key-here

# Anthropic (`llm-eval-lab[anthropic]`)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Google Gemini via google-genai (`llm-eval-lab[google]`)
GOOGLE_API_KEY=your-google-api-key-here

# Any OpenAI-compatible endpoint (self-hosted, third-party gateways, ...).
# Pass the base URL with `--base-url` on `llm-eval run`, not as an
# environment variable — ProviderConfig.base_url is set per run/request, it
# is not read from the environment. Unlike the other providers above, the
# `openai_compatible` provider has NO default credential variable name (many
# self-hosted endpoints need no key at all) — this is only a suggested name;
# pass `--api-key-env OPENAI_COMPATIBLE_API_KEY` explicitly if your endpoint
# needs one, naming whichever variable you actually set.
OPENAI_COMPATIBLE_API_KEY=your-openai-compatible-api-key-here

# Ollama runs locally and normally needs no credential. Pass its host with
# `--base-url` on `llm-eval run` (default http://localhost:11434).
